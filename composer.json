{
    "name": "victormacko/dynamodb-repository",
    "description": "A helper library for retrieving and writing data in/out of AWS DynamoDB",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Victor Macko",
            "email": "victor_macko@hotmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "aws/aws-sdk-php": "^3.300",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/options-resolver": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/serializer": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/service-contracts": "^2.5 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
        "symfony/property-info": "^6.4 || ^7.0 || ^8.0"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "VictorMacko\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VictorMacko\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
